(1 row)

SELECT * FROM float4_tbl WHERE f1 > '0.1' ORDER BY f1;
   f1   
--------
 1004.3
(1 row)

SELECT * FROM float4_tbl WHERE f1 <= '0.1' ORDER BY f1;
  f1  
------
 -2.5
  0.1
(2 rows)

SELECT * FROM float4_tbl WHERE f1 <> '1004.3' ORDER BY f1;
  f1  
------
 -2.5
  0.1
(2 rows)

SELECT * FROM float8_tbl WHERE f1 = 1004.3;
   f1   
--------
 1004.3
(1 row)

DROP TABLE float4_tbl;
DROP TABLE float8_tbl;
