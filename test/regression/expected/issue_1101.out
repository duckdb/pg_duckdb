-- Issue #1101: INSERTs generated by rules should not be executed by DuckDB,
-- because their source is not a single SELECT subquery.
SET duckdb.force_execution = true;
CREATE TABLE shoelace_data (
	sl_name char(10), sl_avail integer, sl_color char(10),
	sl_len float, sl_unit char(8));
CREATE TABLE unit (un_name char(8), un_fact float);
CREATE VIEW shoelace AS
	SELECT s.sl_name, s.sl_avail, s.sl_color, s.sl_len, s.sl_unit,
	       s.sl_len * u.un_fact AS sl_len_cm
	  FROM shoelace_data s, unit u WHERE s.sl_unit = u.un_name;
INSERT INTO unit VALUES ('cm', 1.0), ('inch', 2.54), ('m', 100.0);
INSERT INTO shoelace_data VALUES ('sl3', 0, 'black', 35.0, 'inch');
INSERT INTO shoelace_data VALUES ('sl6', 0, 'brown', 0.9, 'm');
INSERT INTO shoelace_data VALUES ('sl8', 1, 'brown', 40, 'inch');
-- log_who uses text instead of name, so DuckDB supports all the column types
CREATE TABLE shoelace_log (
    sl_name char(10), sl_avail integer, log_who text, log_when timestamp);
CREATE RULE log_shoelace AS ON UPDATE TO shoelace_data
    WHERE NEW.sl_avail != OLD.sl_avail
    DO INSERT INTO shoelace_log VALUES (NEW.sl_name, NEW.sl_avail, 'Al Bundy', 'epoch');
CREATE RULE shoelace_upd AS ON UPDATE TO shoelace
    DO INSTEAD UPDATE shoelace_data SET
           sl_name = NEW.sl_name, sl_avail = NEW.sl_avail,
           sl_color = NEW.sl_color, sl_len = NEW.sl_len, sl_unit = NEW.sl_unit
     WHERE sl_name = OLD.sl_name;
CREATE TABLE shoelace_arrive (arr_name char(10), arr_quant integer);
CREATE TABLE shoelace_ok (ok_name char(10), ok_quant integer);
CREATE RULE shoelace_ok_ins AS ON INSERT TO shoelace_ok
    DO INSTEAD UPDATE shoelace SET sl_avail = sl_avail + NEW.ok_quant
     WHERE sl_name = NEW.ok_name;
INSERT INTO shoelace_arrive VALUES ('sl3', 10), ('sl6', 20), ('sl8', 20);
insert into shoelace_ok select * from shoelace_arrive;
SELECT * FROM shoelace_data ORDER BY sl_name;
 sl_name | sl_avail | sl_color | sl_len | sl_unit 
---------+----------+----------+--------+---------
 sl3     |       10 | black    |     35 | inch
 sl6     |       20 | brown    |    0.9 | m
 sl8     |       21 | brown    |     40 | inch
(3 rows)

-- Should contain the new sl_avail values
SELECT * FROM shoelace_log ORDER BY sl_name;
 sl_name | sl_avail | log_who  |         log_when         
---------+----------+----------+--------------------------
 sl3     |       10 | Al Bundy | Thu Jan 01 00:00:00 1970
 sl6     |       20 | Al Bundy | Thu Jan 01 00:00:00 1970
 sl8     |       21 | Al Bundy | Thu Jan 01 00:00:00 1970
(3 rows)

-- A DO ALSO rule with an INSERT ... SELECT action
CREATE TABLE arrive_log (arr_name char(10), arr_quant integer, factor float);
CREATE RULE arrive_ins AS ON INSERT TO shoelace_arrive
    DO ALSO INSERT INTO arrive_log
        SELECT NEW.arr_name, NEW.arr_quant, u.un_fact FROM unit u WHERE u.un_name = 'm';
INSERT INTO shoelace_arrive SELECT 'sl9', 5;
SELECT * FROM arrive_log ORDER BY arr_name;
 arr_name | arr_quant | factor 
----------+-----------+--------
 sl9      |         5 |    100
(1 row)

-- INSERT ... SELECT into an auto-updatable view is not generated by a rule
CREATE VIEW arrive_view AS SELECT arr_name, arr_quant FROM shoelace_arrive;
INSERT INTO arrive_view SELECT 'sl10', 7;
SELECT * FROM shoelace_arrive ORDER BY arr_name;
 arr_name | arr_quant 
----------+-----------
 sl10     |         7
 sl3      |        10
 sl6      |        20
 sl8      |        20
 sl9      |         5
(5 rows)

SELECT * FROM arrive_log ORDER BY arr_name;
 arr_name | arr_quant | factor 
----------+-----------+--------
 sl10     |         7 |    100
 sl9      |         5 |    100
(2 rows)

DROP TABLE shoelace_data, unit, shoelace_log, shoelace_arrive, shoelace_ok, arrive_log CASCADE;
NOTICE:  drop cascades to 2 other objects
DETAIL:  drop cascades to view arrive_view
drop cascades to view shoelace
