-- Issue #1100: CREATE TABLE ... AS EXECUTE is not supported for DuckDB tables
PREPARE data_sel AS SELECT 1 AS a;
CREATE TABLE tbl_nodata4 (a) USING duckdb AS EXECUTE data_sel WITH NO DATA;
ERROR:  CREATE TABLE ... AS EXECUTE is not supported for DuckDB tables
HINT:  Use CREATE TABLE ... AS SELECT instead.
CREATE TEMP TABLE t USING duckdb AS EXECUTE data_sel WITH NO DATA;
ERROR:  CREATE TABLE ... AS EXECUTE is not supported for DuckDB tables
HINT:  Use CREATE TABLE ... AS SELECT instead.
CREATE TEMP TABLE t USING duckdb AS EXECUTE data_sel;
ERROR:  CREATE TABLE ... AS EXECUTE is not supported for DuckDB tables
HINT:  Use CREATE TABLE ... AS SELECT instead.
SET default_table_access_method = duckdb;
CREATE TEMP TABLE t AS EXECUTE data_sel;
ERROR:  CREATE TABLE ... AS EXECUTE is not supported for DuckDB tables
HINT:  Use CREATE TABLE ... AS SELECT instead.
RESET default_table_access_method;
-- Postgres tables still work, also with DuckDB execution
CREATE TEMP TABLE t_heap1 AS EXECUTE data_sel WITH NO DATA;
SET duckdb.force_execution = true;
CREATE TEMP TABLE t_heap2 AS EXECUTE data_sel WITH NO DATA;
CREATE TEMP TABLE t_heap3 AS EXECUTE data_sel;
SELECT * FROM t_heap3;
 a 
---
 1
(1 row)

RESET duckdb.force_execution;
DROP TABLE t_heap1, t_heap2, t_heap3;
DEALLOCATE data_sel;
